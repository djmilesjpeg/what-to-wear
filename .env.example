# Copy to `.env` to test the morning alert locally (never commit `.env`).
#   npm run alert:dry   -> prints the message; Telegram values not needed
#   npm run alert       -> sends it to Telegram

LATITUDE=40.7128
LONGITUDE=-74.0060

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
TEMP_UNIT=F
LOCATION_NAME=New York
TOLERANCE=normal
